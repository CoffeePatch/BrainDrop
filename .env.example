# ==============================================================================
# BrainDrop Configuration Environment Variables
# Copy this file to '.env' and fill in your private credentials.
# Never commit '.env' or service account key files to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Raindrop.io API Credentials
# Create a test token at: https://app.raindrop.io/settings/integrations
# ------------------------------------------------------------------------------
RAINDROP_TOKEN=your_raindrop_test_or_oauth_token_here

# ------------------------------------------------------------------------------
# 2. Google Cloud Firestore Credentials
# Option A (Recommended for CI/CD & Local): Direct Env Variables
# Option B (Local development): Path to service-account.json file
# 
# To obtain Firebase credentials:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Go to Project Settings -> Service Accounts -> Firebase Admin SDK
# 3. Click "Generate new private key" to download your service account JSON file.
# 4. Extract projectId, clientEmail, and privateKey into the variables below (or set GOOGLE_APPLICATION_CREDENTIALS).
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Note: For multiline private keys in .env, wrap in quotes and keep \n escaped
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Path to local Google Service Account JSON file (overrides env keys if set)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ------------------------------------------------------------------------------
# 3. AI Automation Credentials (Optional - Phase 3)
# Free Tier API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Engine Defaults & Runtime Preferences
# ------------------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Default Keeper Strategy: KEEP_NEWEST_INHERIT_OLD | KEEP_OLDEST_MERGE_NEW | KEEP_RICHEST
DEFAULT_KEEPER_STRATEGY=KEEP_NEWEST_INHERIT_OLD

# Sync batch size (max 500 per Firestore transaction)
FIRESTORE_BATCH_SIZE=500

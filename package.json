{
  "name": "braindrop",
  "version": "1.0.0",
  "description": "Intelligent, scalable personal bookmark automation and maintenance engine for Raindrop.io",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "braindrop": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "sync": "tsx src/index.ts sync",
    "duplicates": "tsx src/index.ts duplicates --dry-run",
    "duplicates:apply": "tsx src/index.ts duplicates --live",
    "tags": "tsx src/index.ts tags --dry-run",
    "tags:apply": "tsx src/index.ts tags --live",
    "rules": "tsx src/index.ts rules --dry-run",
    "rules:apply": "tsx src/index.ts rules --live",
    "categorize": "tsx src/index.ts categorize --dry-run",
    "categorize:apply": "tsx src/index.ts categorize --live",
    "links": "tsx src/index.ts links --dry-run",
    "links:apply": "tsx src/index.ts links --live",
    "clean": "tsx src/index.ts clean --dry-run",
    "clean:apply": "tsx src/index.ts clean --live",
    "check": "tsx src/index.ts check",
    "status": "tsx src/index.ts status",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "raindrop",
    "bookmarks",
    "automation",
    "firestore",
    "duplicate-remover",
    "intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

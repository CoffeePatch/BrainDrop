[
  {
    "name": "GitHub Code & Documentation",
    "domain": "github.com",
    "targetCollection": "Development",
    "tags": ["code"],
    "subpaths": [
      {
        "pattern": "/*/wiki/*",
        "tags": ["docs", "wiki"],
        "targetCollection": "Documentation"
      },
      {
        "pattern": "/*/releases/*",
        "tags": ["release", "changelog"]
      },
      {
        "pattern": "/*/issues/*",
        "tags": ["issue", "discussion"]
      }
    ]
  },
  {
    "name": "Academic & Research Preprints",
    "domain": "arxiv.org",
    "targetCollection": "Research Papers",
    "tags": ["research", "paper"],
    "subpaths": [
      {
        "pattern": "/pdf/*",
        "tags": ["pdf"]
      }
    ]
  },
  {
    "name": "YouTube Videos & Courses",
    "domain": "youtube.com",
    "tags": ["video"],
    "subpaths": [
      {
        "pattern": "/playlist*",
        "tags": ["course", "playlist"],
        "targetCollection": "Learning / Courses"
      },
      {
        "pattern": "/watch*",
        "tags": ["video-lesson"]
      }
    ]
  },
  {
    "name": "Technical Subreddits",
    "domain": "reddit.com",
    "targetCollection": "Communities",
    "tags": ["social"],
    "subpaths": [
      {
        "pattern": "/r/programming/*",
        "tags": ["programming", "tech"]
      },
      {
        "pattern": "/r/typescript/*",
        "tags": ["typescript", "tech"]
      }
    ]
  },
  {
    "name": "General PDF Documents",
    "fileExtensions": [".pdf"],
    "targetCollection": "Documents & PDFs",
    "tags": ["pdf"]
  }
]
